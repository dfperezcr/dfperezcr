{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/record.py" } ] },
      { "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/install_statusline.py" } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/record.py" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/record.py" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/record.py" } ] }
    ]
  }
}
